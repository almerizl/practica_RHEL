COMANDOS EJECUTADOS:

1. Crear un playbook para instalar la aplicación notepad++ en la máquina ansible2 (Windows)
cat << 'EOF' | sudo tee /etc/ansible/install_notepad.yml
---
- name: Instalar Notepad++ en Windows
  hosts: win
  tasks:
    - name: Descargar e instalar Notepad++ mediante Chocolatey
      chocolatey.chocolatey.win_chocolatey:
        name: notepadplusplus
        state: present
EOF

sudo su - ansible -c "ansible-playbook /etc/ansible/install_notepad.yml"

2. Crear un playbook en la máquina ansible1 (linux) para que instale NGINX e inicie el servicio
cat << 'EOF' | sudo tee /etc/ansible/install_nginx.yml
---
- name: Instalar y configurar NGINX en Linux
  hosts: linux
  become: yes
  tasks:
    - name: Actualizar repositorios e instalar NGINX
      ansible.builtin.apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Iniciar y habilitar el servicio NGINX
      ansible.builtin.service:
        name: nginx
        state: started
        enabled: yes
EOF

sudo su - ansible -c "ansible-playbook /etc/ansible/install_nginx.yml"

