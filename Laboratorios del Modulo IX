PRÁCTICA 2: DESPLIEGUE DE UNA VM CON TERRAFORM EN DIGITALOCEAN
================================================================================
CONFIGURACIÓN EN EL SERVIDOR (RHEL)
================================================================================
COMANDOS EJECUTADOS:

1. Instalar dependencias y agregar el repositorio oficial de HashiCorp Terraform
sudo dnf install -y yum-utils
sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo

2. Instalar Terraform
sudo dnf install -y terraform

3. Crear el directorio de trabajo para la infraestructura como código
mkdir -p /home/terraform_do && cd /home/terraform_do

# 4. Generar par de llaves SSH en la máquina servidora (sin contraseña)
ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -N ""

# 5. Crear el archivo de configuración main.tf de Terraform
cat << 'EOF' > main.tf
terraform {
  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.0"
    }
  }
}

provider "digitalocean" {
  token = var.do_token
}

variable "do_token" {}

resource "digitalocean_ssh_key" "default" {
  name       = "ansible-controller-key"
  public_key = file("~/.ssh/id_rsa.pub")
}

resource "digitalocean_droplet" "OS3vm" {
  image    = "ubuntu-22-04-x64"
  name     = "OS3vm"
  region   = "nyc1"
  size     = "s-1vcpu-1gb"
  ssh_keys = [digitalocean_ssh_key.default.fingerprint]
}

output "ip_address" {
  value = digitalocean_droplet.OS3vm.ipv4_address
}
EOF

# 6. Inicializar y aplicar la configuración de Terraform
terraform init
terraform apply -var="do_token=TU_DIGITALOCEAN_API_TOKEN" -auto-approve

# 7. Validar conexión SSH desde RHEL hacia la nueva VM de DigitalOcean
ssh root@146.190.220.5

