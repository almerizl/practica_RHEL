# Máquina 1 (MASTER, prioridad 100)
echo "<h1>Bienvenidos a: Server 1</h1>" > /var/www/html/sitio80/index.html
systemctl restart httpd

nano /etc/keepalived/keepalived.conf
# global_defs { router_id nodo1 }
