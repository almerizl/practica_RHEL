### Ansible
```bash
sudo dnf install -y epel-release
sudo dnf install -y ansible
pip3 install pywinrm

sudo useradd -m ansible
echo "ansible ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/ansible
sudo su - ansible -c "ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -N ''"

cat /home/ansible/.ssh/id_rsa.pub | ssh root@IP_REMOTA "useradd -m ansible 2>/dev/null; echo 'ansible ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/ansible; mkdir -p /home/ansible/.ssh && cat >> /home/ansible/.ssh/authorized_keys && chown -R ansible:ansible /home/ansible/.ssh && chmod 700 /home/ansible/.ssh && chmod 600 /home/ansible/.ssh/authorized_keys"

sudo rm -rf /etc/ansible/hosts
cat << 'EOF' | sudo tee /etc/ansible/hosts
[linux]
IP_REMOTA ansible_user=ansible

[win]
IP_WINDOWS ansible_user=ansible ansible_password=CONTRASEÑA ansible_connection=winrm ansible_winrm_transport=basic ansible_port=5985 ansible_winrm_server_cert_validation=ignore
EOF

sudo su - ansible -c "ansible linux -m ping"
sudo su - ansible -c "ansible win -m win_ping"
```

