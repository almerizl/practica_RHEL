PRÁCTICA 3: DESPLIEGUE DE CONTENEDOR DE WORDPRESS UTILIZANDO DOCKER-COMPOSE
================================================================================
CONFIGURACIÓN EN EL SERVIDOR (RHEL)
--------------------------------------------------------------------------------

COMANDOS EJECUTADOS:

# 1. Descarga del binario de Docker-Compose desde el repositorio oficial de GitHub
sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose

# 2. Asignación de permisos de ejecución al ejecutable de Docker-Compose
sudo chmod +x /usr/local/bin/docker-compose

# 3. Creación del directorio de trabajo e ingreso a la ruta del proyecto
mkdir -p /home/wordpress_compose && cd /home/wordpress_compose

# 4. Creación del archivo docker-compose.yml declarando servicios, variables de entorno y volúmenes
cat << 'EOF' > docker-compose.yml
version: '3.8'

services:
  db:
    image: mysql:8.0
    container_name: wordpress_db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root_password_123
      MYSQL_DATABASE: wordpress_db
      MYSQL_USER: wp_user
      MYSQL_PASSWORD: wp_password_123
    volumes:
      - db_data:/var/lib/mysql:Z

  wordpress:
    image: wordpress:latest
    container_name: wordpress_app
    restart: always
    depends_on:
      - db
    ports:
      - "8080:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wp_user
      WORDPRESS_DB_PASSWORD: wp_password_123
      WORDPRESS_DB_NAME: wordpress_db
    volumes:
      - wp_data:/var/www/html:Z

volumes:
  db_data:
  wp_data:
EOF

# 5. Despliegue de los contenedores mediante Docker-Compose en segundo plano
sudo docker-compose up -d2
